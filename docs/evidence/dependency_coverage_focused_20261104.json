  "replacement_goal": "Complete bounded metadata and typed constant reference discovery while retaining conservative unknown coverage.",
  "behavior": [
    "Index metadata IDs before validating complete records, allowing forward references and cycles without recursive expansion.",
    "Parse explicit debug-node field schemas, tuples, empty DIExpression, attachments, typed constants, GEPs, casts, aggregates and parameter attributes.",
    "Retain raw metadata unchanged and keep its typed global references as module roots; strings remain data only in recognized fields.",
    "ConstMerge retains definitions still named by raw regions and reports unchanged when no structured use or definition changes.",
    "Standalone reference walks remain conservative; unsupported forms, unknown strings, missing or duplicate IDs and excessive nesting stay unknown."
  ],
  "observed_bug": "Existing FunctionAttrs appended inferred attributes after !dbg, producing invalid LLVM IR on the new release-o3 regression. Insertion now respects trailing header clauses and quoted/nested tokens.",
  "upstream_mapping": [
    {
      "path": "../llvm-project-22/llvm/lib/AsmParser/LLParser.cpp",
      "owners": [
        "parseMetadata",
