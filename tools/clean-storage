#!/usr/bin/env bash
set -euo pipefail
source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
project_root=$(cd -- "${ZLLVM_PROJECT_ROOT:-$source_root}" && pwd -P)
storage_state="$project_root/local-state/storage-cleanup"
if [[ -L "$project_root/local-state" || -L "$storage_state" ]]; then
    printf 'Storage cleanup state must be inside the project, without symlinks.\n' >&2
    exit 2
fi
mkdir -p -- "$storage_state"
if [[ ${1:-} == exec || ${1:-} == maintain ]]; then
    cleanup_mode=$1
    shift
    cleanup_release_request=
    if [[ $cleanup_mode == maintain && ${1:-} == --release-request ]]; then
        if [[ $# -lt 3 ]]; then printf 'maintain --release-request needs a file and a command.\n' >&2; exit 2; fi
        cleanup_release_request=$2
        shift 2
    fi
    if [[ ${1:-} == -- ]]; then shift; fi
    if [[ $# == 0 ]]; then printf 'usage: tools/clean-storage exec -- COMMAND [ARG...]\n' >&2; exit 2; fi
    # The collector takes an exclusive flock on this same file.
    cd -- "$project_root"
    if [[ $cleanup_mode == exec ]]; then exec flock --shared "$storage_state/cleanup.lock" "$@"; fi
    cleanup_command_status=0
    flock --shared "$storage_state/cleanup.lock" "$@" || cleanup_command_status=$?
    cleanup_collection_status=0
    if (( cleanup_command_status == 0 )) && [[ -n $cleanup_release_request ]]; then
        "$source_root/tools/clean-storage" release --request "$cleanup_release_request" || cleanup_collection_status=$?
    fi
    if (( cleanup_collection_status == 0 )); then
        "$source_root/tools/clean-storage" --minimal --apply || cleanup_collection_status=$?
    fi
    if (( cleanup_command_status != 0 )); then exit "$cleanup_command_status"; fi
    exit "$cleanup_collection_status"
fi
cd -- "$source_root"
cleanup_zig=${ZIG:-zig}
if [[ $("$cleanup_zig" version) != $(cat .zigversion) ]]; then
    printf 'Select the compiler pinned in .zigversion with ZIG=/path/to/zig.\n' >&2
    exit 2
fi
sha256sum --check --quiet --strict tools/vendor/file_audit.SHA256SUMS tools/vendor/process.SHA256SUMS tools/vendor/test_support.SHA256SUMS
# Serialize building the reusable helper, including two simultaneous invocations.
exec 9> "$storage_state/build.lock"
flock --exclusive 9
"$cleanup_zig" build-exe -O ReleaseFast tools/clean_storage.zig \
    --cache-dir "$storage_state/tool-cache" \
    --global-cache-dir "$storage_state/tool-global-cache" \
    -femit-bin="$storage_state/clean-storage.new"
mv -- "$storage_state/clean-storage.new" "$storage_state/clean-storage"
flock --unlock 9
exec 9>&-
cd -- "$project_root"
exec "$storage_state/clean-storage" "$@"
